APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Comma-separated list of superseded APP_KEYs, kept so existing ciphertext
# (encrypted columns, cookies) can still be decrypted after a key rotation.
APP_PREVIOUS_KEYS=

# Proxies trusted for X-Forwarded-* headers. "*" trusts all (correct behind a
# single reverse proxy / load balancer you control).
TRUSTED_PROXIES=*

# Task pipeline. The allow-lists are comma-separated; leave blank to use the
# built-in defaults from config/app.php.
ENABLE_TASK_PIPELINE=true
ALLOWED_TASK_JOBS=
ALLOWED_TASK_COMMANDS=

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily,info
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14
# Default for the per-user debug logging toggle.
APP_DEBUG_LOGGING_DEFAULT=true

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=postgres
DB_PASSWORD=postgres

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# Horizon dashboard
HORIZON_PATH=horizon
# HORIZON_DOMAIN=
# Comma-separated emails allowed to view Horizon in non-local environments.
HORIZON_ALLOWED_EMAILS=

# Activity log (spatie/laravel-activitylog)
ACTIVITY_LOGGER_ENABLED=true
ACTIVITY_LOGGER_TABLE_NAME=activity_log
# Defaults to the primary DB connection when blank.
ACTIVITY_LOGGER_DB_CONNECTION=

# Laravel Reverb (WebSocket server) — used by iOS companion app
REVERB_APP_ID=spark
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Media Library
MEDIA_DISK=local
# MEDIA_DISK=s3  # Use this in production
MEDIA_QUEUE=default
QUEUE_CONVERSIONS_BY_DEFAULT=true
QUEUE_CONVERSIONS_AFTER_DB_COMMIT=true
MEDIA_TEMPORARY_URL_DEFAULT_LIFETIME=60
MEDIA_DOWNLOADER_SSL=true
MEDIA_PREFIX=
IMAGE_DRIVER=gd
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
FFMPEG_TIMEOUT=900
FFMPEG_THREADS=0
FORCE_MEDIA_LIBRARY_LAZY_LOADING=true
ENABLE_MEDIA_LIBRARY_VAPOR_UPLOADS=false

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-2
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# AWS_URL=  # Optional: Custom S3 endpoint URL
# AWS_ENDPOINT=  # Optional: S3-compatible endpoint (MinIO, R2, etc.)

# Oyster (TfL travel) email storage
AWS_REGION_OYSTER=eu-west-2
AWS_BUCKET_OYSTER=spark-oyster-emails

VITE_APP_NAME="${APP_NAME}"

# GitHub OAuth credentials
GITHUB_CLIENT_ID=test
GITHUB_CLIENT_SECRET=test
GITHUB_REDIRECT_URI=https://localhost/integrations/github/callback

# Authelia SSO (application login)
AUTHELIA_BASE_URL=
AUTHELIA_CLIENT_ID=
AUTHELIA_CLIENT_SECRET=
AUTHELIA_REDIRECT_URI=https://localhost/auth/authelia/callback

# Spotify OAuth credentials
SPOTIFY_CLIENT_ID=test
SPOTIFY_CLIENT_SECRET=test
SPOTIFY_REDIRECT_URI=https://localhost/integrations/spotify/callback

# Reddit OAuth credentials
REDDIT_CLIENT_ID=test
REDDIT_CLIENT_SECRET=test
REDDIT_REDIRECT_URI=https://localhost/integrations/reddit/callback
REDDIT_USERAGENT="SparkApp/1.0 by u/example"

# Bluesky OAuth (atproto). The private key is a PEM/JWK used to sign client
# assertions — generate one per deployment.
BLUESKY_OAUTH_PRIVATE_KEY=
BLUESKY_REDIRECT=/bluesky/oauth/callback

# Sentry Backend (Laravel)
SENTRY_LARAVEL_DSN=https://fe021cdd20bed202e5d5f8a1bdc773f2@sentry.cronx.co/2
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0
SENTRY_RELEASE=
SENTRY_SEND_DEFAULT_PII=true
SENTRY_PROJECT_NAME=sparkapp

# Sentry MCP Tracing
SENTRY_MCP_TRACING_ENABLED=true
SENTRY_MCP_SAMPLE_RATE=1.0

# Sentry Frontend (Browser)
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=1.0

# Sentry source map upload at build time (vite.config.js). Uploads are skipped
# entirely unless SENTRY_AUTH_TOKEN is set.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=


OURA_CLIENT_ID=test
OURA_CLIENT_SECRET=test
OURA_REDIRECT_URI=https://localhost/integrations/oura/callback

MONZO_CLIENT_ID=test
MONZO_CLIENT_SECRET=test
MONZO_REDIRECT_URI=https://localhost/integrations/monzo/callback
MONZO_SALARY_NAME=Employer

HEVY_API_KEY=

# GoCardless Bank Account Data API
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=
GOCARDLESS_API_BASE=https://bankaccountdata.gocardless.com/api/v2
GOCARDLESS_COUNTRY=GB
GOCARDLESS_INSTITUTION_ID=
GOCARDLESS_REDIRECT_URI=

KARAKEEP_URL=https://karakeep.url.tld
KARAKEEP_ACCESS_TOKEN=your_jwt_token_here

GOOGLE_CALENDAR_CLIENT_ID=test
GOOGLE_CALENDAR_CLIENT_SECRET=test
GOOGLE_CALENDAR_REDIRECT_URI=https://localhost/integrations/google-calendar/callback

# Outline (day notes / knowledge base)
OUTLINE_URL=https://outline.url.tld
OUTLINE_ACCESS_TOKEN=
OUTLINE_DAYNOTES_COLLECTION_ID=
OUTLINE_POLL_INTERVAL_MINUTES=15

# TMDB (film & TV metadata)
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500

# BoardGameGeek (board game metadata)
BOARDGAMEGEEK_BASE_URL=https://boardgamegeek.com/xmlapi2

# Vivino (wine lookup)
VIVINO_SEARCH_URL=https://www.vivino.com/search/wines

# Met Office DataHub (site-specific forecasts)
METOFFICE_API_KEY=
METOFFICE_BASE_URL=https://data.hub.api.metoffice.gov.uk/sitespecific/v0
METOFFICE_CACHE_TTL=1

# Slack notifications
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=

# Geoapify Geocoding API (for location support)
GEOAPIFY_API_KEY=
GEOAPIFY_BASE_URL=https://api.geoapify.com/v1
GEOAPIFY_DAILY_LIMIT=3000

# Playwright Browser Automation (for Fetch integration)
PLAYWRIGHT_ENABLED=false
PLAYWRIGHT_WORKER_URL=http://playwright-worker:3000
PLAYWRIGHT_TIMEOUT=30000
PLAYWRIGHT_SCREENSHOT_ENABLED=true
PLAYWRIGHT_AUTO_ESCALATE=true
PLAYWRIGHT_JS_DOMAINS=twitter.com,x.com,instagram.com,facebook.com
MCP_PLAYWRIGHT_MAX_HTML_BYTES=1048576

# Stealth mode (anti-bot detection)
PLAYWRIGHT_STEALTH_ENABLED=true

# Cookie auto-refresh
PLAYWRIGHT_AUTO_UPDATE_COOKIES=true

# Browser context persistence (caching)
PLAYWRIGHT_CONTEXT_PERSISTENCE=true
PLAYWRIGHT_CONTEXT_TTL=1800

# Use default browser context (includes extensions like cookie popup blocker)
PLAYWRIGHT_USE_DEFAULT_CONTEXT=true

# Scheduled cookie refresh
PLAYWRIGHT_COOKIE_REFRESH_ENABLED=true
PLAYWRIGHT_COOKIE_REFRESH_THRESHOLD=7

# Docker ports
CHROME_VNC_PORT=5900
CHROME_CDP_PORT=9222
CHROME_VNC_URL=vnc://localhost:5900
CHROME_VNC_PASSWORD=spark-dev-vnc

# Fetch pipeline (config/fetch.php)
FETCH_DEBUG=false
# SSRF guard: comma-separated extra hosts allowed even if they resolve to a
# private range. Leave blank to allow none.
FETCH_URL_SAFETY_ALLOWED_HOSTS=
FETCH_URL_SAFETY_MAX_REDIRECTS=10
# Paywall detection tuning.
FETCH_PAYWALL_IGNORED_DOMAINS=
FETCH_PAYWALL_MIN_STRONG_INDICATORS=2
FETCH_PAYWALL_MAX_CONTENT_LENGTH=600

# Archive.org / archive.today paywall bypass
FETCH_ARCHIVE_BYPASS_ENABLED=true
FETCH_ARCHIVE_BYPASS_TIMEOUT=30
# Comma-separated domains that must never be routed via an archive service.
FETCH_ARCHIVE_BYPASS_EXCLUDED_DOMAINS=


OPENAI_API_KEY=thisisademoapikey
OPENAI_ORGANIZATION=
# One model per role. Embedding backs semantic search; extraction handles the
# high-volume summarisation and receipt parsing; reasoning handles agentic work
# (Flint skill runs, tool-calling disambiguation) and wants a stronger model.
# Changing OPENAI_EMBEDDING_MODEL invalidates every stored vector — re-index
# with `artisan embeddings:regenerate --stale-model` afterwards.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EXTRACTION_MODEL=gpt-5-nano
OPENAI_REASONING_MODEL=gpt-4o-mini
OPENAI_PROJECT=
# Override to point at an OpenAI-compatible gateway. Blank uses the OpenAI API.
OPENAI_BASE_URL=
OPENAI_REQUEST_TIMEOUT=120

# Web Push Notifications (VAPID)
# Generate keys with: php artisan webpush:vapid
VAPID_SUBJECT=mailto:support@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Legacy GCM/FCM fallback for older Chrome subscriptions. Optional.
GCM_KEY=
GCM_SENDER_ID=

# APNs (Apple Push Notifications) — iOS companion app
APN_KEY_ID=
APN_TEAM_ID=
APN_BUNDLE_ID=co.cronx.sparkapp
APN_PRIVATE_KEY_PATH=/var/www/html/storage/app/private/apn/AuthKey.p8
APN_PRIVATE_KEY_SECRET=
# Set true for production APNs endpoint; false uses Apple sandbox.
APN_PRODUCTION=false

# Apple Team ID used by the AASA manifest (universal links).
APPLE_TEAM_ID=

# Gate the /api/v1/mobile/* surface on-demand.
IOS_MOBILE_API_ENABLED=false

# Sanctum. Defaults to APP_URL's host plus localhost when blank.
SANCTUM_STATEFUL_DOMAINS=
SANCTUM_TOKEN_PREFIX=

## Currency Conversion
CURRENCY_API_KEY=your_key_here
CURRENCY_BASE=GBP
CURRENCY_CACHE_TTL=24
CURRENCY_API_PROVIDER=exchangerate
CURRENCY_API_URL=https://v6.exchangerate-api.com/v6
# Fall back to the last cached rate when the API is unreachable.
CURRENCY_FALLBACK_ENABLED=true

## Flint Assistant
ASSISTANT_MAX_EVENTS=200

# Flint routine webhooks. Each *_URL is a Claude Code Routine endpoint; leave
# blank to disable that routine. Times are 24h local time.
# Each routine has its own webhook and its own bearer secret, so one leaked
# secret does not authenticate against the others and they rotate independently.
# A routine with no secret of its own falls back to FLINT_ROUTINE_WEBHOOK_SECRET.
FLINT_ROUTINE_WEBHOOK_SECRET=

FLINT_ROUTINE_WEBHOOK_URL=
FLINT_DIGEST_WEBHOOK_SECRET=
FLINT_MORNING_WEEKDAY=07:30
FLINT_MORNING_WEEKEND=09:30
FLINT_MORNING_FALLBACK=11:00
FLINT_EVENING_TIME=19:30

FLINT_TOPICS_WEBHOOK_URL=
FLINT_TOPICS_WEBHOOK_SECRET=
FLINT_TOPICS_TIME=21:00

FLINT_READING_LIST_WEBHOOK_URL=
FLINT_READING_LIST_WEBHOOK_SECRET=
FLINT_READING_LIST_TIME=20:00

FLINT_NEWS_ROUNDUP_WEBHOOK_URL=
FLINT_NEWS_ROUNDUP_WEBHOOK_SECRET=
FLINT_NEWS_ROUNDUP_TIME=07:00

# Receipt Plugin Configuration
RECEIPT_DOMAIN=domain.com
RECEIPT_EMAIL_ADDRESS=receipts@domain.com
RECEIPT_WEBHOOK_SECRET=your_webhook_secret_here
# Percentage tolerance when matching a receipt total to a bank transaction.
RECEIPT_CURRENCY_TOLERANCE=2.0

# AWS Receipt Storage (may differ from main AWS config)
AWS_REGION_RECEIPTS=eu-west-2
AWS_BUCKET_RECEIPTS=spark-receipts-emails
AWS_SNS_RECEIPT_TOPIC_ARN=arn:your_key_here

# Newsletter Integration
NEWSLETTER_DOMAIN=domain.com
NEWSLETTER_EMAIL_ADDRESS=news@domain.com
AWS_BUCKET_NEWSLETTERS=spark-newsletters-emails
AWS_REGION_NEWSLETTERS=eu-west-2
AWS_SNS_NEWSLETTER_TOPIC_ARN=arn:your_key_here

## Local development (docker-compose / Sail)
# All optional — docker-compose.yml has a default for each. Set WWWUSER/WWWGROUP
# to your host uid/gid (`id -u` / `id -g`) so bind-mounted files stay writable.
# WWWUSER=1000
# WWWGROUP=1000
# APP_SERVICE=laravel.test
# APP_PORT=80
# HTTP_PORT=8000
# SSL_PORT=443
# SERVER_NAME=localhost
# SSL_DOMAIN=localhost
# SSL_ALT_NAME=DNS:localhost
# VITE_PORT=5173
# FORWARD_DB_PORT=5432
# FORWARD_REDIS_PORT=6379
# REVERB_FORWARD_PORT=8080
# PLAYWRIGHT_WORKER_PORT=3000
# SAIL_XDEBUG_MODE=off
# SAIL_XDEBUG_CONFIG=client_host=host.docker.internal

## Optional framework overrides
# Everything below has a working default in config/. Uncomment only what you
# need to change — listed here so the full set of supported keys is discoverable.

# Auth (config/auth.php)
# AUTH_GUARD=web
# AUTH_MODEL=App\Models\User
# AUTH_PASSWORD_BROKER=users
# AUTH_PASSWORD_RESET_TOKEN_TABLE=password_reset_tokens
# AUTH_PASSWORD_TIMEOUT=10800

# Database (config/database.php)
# DB_URL=
# DB_SOCKET=
# DB_CHARSET=utf8
# DB_COLLATION=utf8_unicode_ci
# DB_PREFIX=
# DB_PERSISTENT=false
# DB_FOREIGN_KEYS=true          # sqlite only
# DB_ENCRYPT=yes                # sqlsrv only
# DB_TRUST_SERVER_CERTIFICATE=false
# MYSQL_ATTR_SSL_CA=

# Redis (config/database.php, config/reverb.php)
# REDIS_URL=
# REDIS_USERNAME=
# REDIS_DB=0
# REDIS_CACHE_DB=1
# REDIS_PREFIX=
# REDIS_CLUSTER=redis
# REDIS_PERSISTENT=false
# REDIS_TIMEOUT=60

# Cache (config/cache.php)
# DB_CACHE_CONNECTION=
# DB_CACHE_TABLE=cache
# DB_CACHE_LOCK_CONNECTION=
# DB_CACHE_LOCK_TABLE=cache_locks
# REDIS_CACHE_CONNECTION=cache
# REDIS_CACHE_LOCK_CONNECTION=default
# DYNAMODB_CACHE_TABLE=cache
# DYNAMODB_ENDPOINT=
# MEMCACHED_PORT=11211
# MEMCACHED_PERSISTENT_ID=
# MEMCACHED_USERNAME=
# MEMCACHED_PASSWORD=

# Queue (config/queue.php)
# QUEUE_FAILED_DRIVER=database-uuids
# DB_QUEUE_CONNECTION=
# DB_QUEUE_TABLE=jobs
# DB_QUEUE=default
# DB_QUEUE_RETRY_AFTER=90
# REDIS_QUEUE_CONNECTION=default
# REDIS_QUEUE=default
# REDIS_QUEUE_RETRY_AFTER=90
# BEANSTALKD_QUEUE_HOST=localhost
# BEANSTALKD_QUEUE=default
# BEANSTALKD_QUEUE_RETRY_AFTER=90
# SQS_PREFIX=https://sqs.eu-west-2.amazonaws.com/your-account-id
# SQS_QUEUE=default
# SQS_SUFFIX=

# Session (config/session.php)
# SESSION_STORE=
# SESSION_CONNECTION=
# SESSION_TABLE=sessions
# SESSION_EXPIRE_ON_CLOSE=false
# SESSION_HTTP_ONLY=true
# SESSION_SECURE_COOKIE=
# SESSION_SAME_SITE=lax
# SESSION_PARTITIONED_COOKIE=false

# Broadcasting (config/broadcasting.php) — Spark uses Reverb by default
# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_APP_CLUSTER=mt1
# PUSHER_HOST=
# PUSHER_PORT=443
# PUSHER_SCHEME=https
# ABLY_KEY=

# Reverb tuning (config/reverb.php)
# REVERB_SERVER=reverb
# REVERB_SERVER_PATH=
# REVERB_MAX_REQUEST_SIZE=10000
# REVERB_SCALING_ENABLED=false
# REVERB_SCALING_CHANNEL=reverb
# REVERB_PULSE_INGEST_INTERVAL=15
# REVERB_TELESCOPE_INGEST_INTERVAL=15
# REVERB_APP_ACTIVITY_TIMEOUT=30
# REVERB_APP_PING_INTERVAL=60
# REVERB_APP_MAX_CONNECTIONS=
# REVERB_APP_MAX_MESSAGE_SIZE=10000
# REVERB_APP_ACCEPT_CLIENT_EVENTS_FROM=
# REVERB_APP_RATE_LIMITING_ENABLED=false
# REVERB_APP_RATE_LIMIT_MAX_ATTEMPTS=60
# REVERB_APP_RATE_LIMIT_DECAY_SECONDS=60
# REVERB_APP_RATE_LIMIT_TERMINATE=false

# Mail transports (config/mail.php, config/services.php)
# MAIL_URL=
# MAIL_EHLO_DOMAIN=
# MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"
# MAIL_LOG_CHANNEL=
# POSTMARK_TOKEN=
# POSTMARK_MESSAGE_STREAM_ID=
# RESEND_KEY=

# Logging channels (config/logging.php)
